{
  "name": "@data-insights-ai/ui",
  "version": "0.1.1",
  "description": "datAInsights component workbench. All rights reserved.",
  "type": "module",
  "module": "./dist/lib/index.js",
  "packageManager": "pnpm@12.5.1",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-insights-ai/storybook.git"
  },
  "scripts": {
    "storybook": "storybook dev -p 4500",
    "build": "vite build --config vite.lib.config.ts && node scripts/build-styles.mjs && node scripts/check-treeshake.mjs",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=storybook",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "lucide-react": "^0.544.0"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/sansation": "^5.2.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.10",
    "typescript": "~5.9.3",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  }
}
